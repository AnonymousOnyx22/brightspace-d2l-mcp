{
  "name": "brightspace-d2l-mcp",
  "version": "1.4.4",
  "mcpName": "io.github.AnonymousOnyx22/brightspace-d2l-mcp",
  "description": "Brightspace MCP server for D2L: connect Brightspace to Claude, ChatGPT, Cursor, Copilot and any AI agent. One-command setup at any school with normal browser sign-in (SSO, Duo, MFA). Due dates with real submission status, exam and calendar events, what's new catch-up, grades and target-grade calculator, calendar export, assignments, content, announcements.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "brightspace-d2l-mcp": "build/index.js"
  },
  "files": [
    "build",
    "!build/**/*.map",
    "!build/**/*.d.ts",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "setup": "node build/index.js setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats": "node scripts/stats.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "file-type": "^21.3.4",
    "playwright-core": "^1.64.1",
    "sanitize-filename": "^1.6.3",
    "turndown": "^7.2.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "AnonymousOnyx22",
  "homepage": "https://brightspace-mcp.netlify.app",
